<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="1dp" android:left="1dp">
                <shape android:shape="oval">
                    <size android:width="22dp" android:height="22dp" />
                    <solid android:color="?attr/alphaPrimaryColor" />
                </shape>
            </item>
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="oval">
                    <size android:width="22dp" android:height="22dp" />
                    <solid android:color="?attr/primaryColor" />
                    <stroke android:width="3dp" android:color="?attr/secondaryColor" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="1dp" android:left="1dp">
                <shape android:shape="oval">
                    <size android:width="18dp" android:height="18dp" />
                    <solid android:color="?attr/alphaPrimaryColor" />
                </shape>
            </item>
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="oval">
                    <size android:width="18dp" android:height="18dp" />
                    <solid android:color="?attr/primaryColor" />
                    <stroke android:width="2dp" android:color="?attr/secondaryColor" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>


