<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:background="@drawable/bs_background">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="16dp"
            android:layout_marginVertical="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/bs_theme_back"
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="?attr/primaryTextColor"
                android:background="@drawable/button_ripple_effect"
                android:src="@drawable/ic_next"
                android:scaleType="fitCenter"
                android:rotation="180"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Выбор темы"
                android:gravity="center_vertical"
                android:textColor="?attr/primaryTextColor"
                android:textStyle="bold"
                android:layout_marginStart="12dp"
                android:textSize="18sp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/dt_border_color"/>

        <LinearLayout
            android:id="@+id/themeAutoOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:background="@android:color/transparent"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="0.9"
                android:scaleY="0.9"
                android:src="@drawable/ic_auto"
                app:tint="?attr/primaryTextColor"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Авто"
                android:textColor="?attr/primaryTextColor"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/themeAutoCheck"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/secondaryColor"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themeLightOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:background="@android:color/transparent"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_light"
                app:tint="?attr/primaryTextColor"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Светлая"
                android:textColor="?attr/primaryTextColor"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/themeLightCheck"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/secondaryColor"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themeDarkOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:background="@android:color/transparent"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleX="0.8"
                android:scaleY="0.8"
                android:src="@drawable/ic_night"
                app:tint="?attr/primaryTextColor"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Темная"
                android:textColor="?attr/primaryTextColor"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/themeDarkCheck"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check"
                app:tint="?attr/secondaryColor"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
