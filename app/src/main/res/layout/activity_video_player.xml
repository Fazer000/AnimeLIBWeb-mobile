<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_color"
    android:fitsSystemWindows="false">

    <!-- Loading Overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_color"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/white_color" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Загрузка видео..."
            android:textColor="?attr/primaryTextColor"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Video Player View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:animation_enabled="false"
        app:controller_layout_id="@layout/custom_player_controller"
        app:repeat_toggle_modes="none"
        app:show_buffering="never"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_shuffle_button="false"
        app:show_subtitle_button="false" />

    <!-- Swipe seek preview -->
    <TextView
        android:id="@+id/seekPreviewText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/video_time_background"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="+0 c"
        android:textColor="?attr/primaryTextColor"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Hold-to-speed plaque -->
    <TextView
        android:id="@+id/holdSpeedToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/video_time_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="2x"
        android:textColor="?attr/primaryTextColor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Skip segment button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/skipSegmentButton"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:paddingVertical="0dp"
        android:paddingHorizontal="15dp"
        android:textAllCaps="false"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="20dp"
        android:text="Пропустить сегмент"
        android:textColor="@color/gray_color"
        android:textSize="14dp"
        app:rippleColor="@color/dt_line_color"
        style="@style/Widget.Material3.Button.TextButton"
        android:backgroundTint="?attr/alphaPrimaryColor"
        app:strokeColor="?attr/alphaBorderColor"
        app:strokeWidth="0.5dp"
        app:cornerRadius="12dp"
        android:visibility="gone" />

    <View
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dt_alpha_primary_color"
        android:clickable="true"
        android:visibility="visible" />

    <!-- Sliding Menu Panel -->
    <androidx.cardview.widget.CardView
        android:id="@+id/slidingMenuPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="?attr/primaryColor"
        android:layout_gravity="top|end"
        android:outlineProvider="bounds">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black_color"
                app:cardCornerRadius="16dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <!-- Menu Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/menu_header_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.02"
                            android:text="Озвучка"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/closeMenuButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="Close Menu"
                            android:foreground="@drawable/ripple_circle"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_close"
                            app:tint="?attr/primaryTextColor" />

                    </LinearLayout>

                    <!-- Player Tabs -->

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/playerTabLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/primaryColor"
                        app:tabGravity="fill"
                        app:tabIndicatorColor="?attr/secondaryColor"
                        app:tabIndicatorGravity="bottom"
                        app:tabIndicatorHeight="3dp"
                        app:tabMode="fixed"
                        app:tabSelectedTextColor="?attr/primaryTextColor"
                        app:tabTextColor="?attr/accentTextColor" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Players List Container with loading overlay -->
            <androidx.cardview.widget.CardView
                android:id="@+id/playersContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="?attr/primaryColor"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/playersViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/menuLoadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/primaryColor"
                    android:visibility="visible">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/menuLoadingIndicator"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/secondaryColor"
                        app:trackCornerRadius="8dp"
                        app:trackThickness="4dp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Comments Side Panel -->
    <LinearLayout
        android:id="@+id/commentsPanel"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="top|end"
        android:background="@drawable/non_stroke_background"
        android:elevation="200dp"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black_color"
            app:cardCornerRadius="16dp"
            app:cardElevation="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black_color"
                android:orientation="vertical">
                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/menu_header_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.02"
                        android:text="Комментарии"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/commentsOptionsButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/button_ripple_effect"
                        android:contentDescription="Options"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_more_vert"
                        app:tint="?attr/primaryTextColor" />

                    <ImageButton
                        android:id="@+id/closeCommentsButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/button_close_background"
                        android:contentDescription="Close Comments"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_close"
                        app:tint="?attr/primaryTextColor" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <FrameLayout
            android:id="@+id/commentsContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="8dp" />

            <TextView
                android:id="@+id/emptyCommentsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Комментариев пока нет"
                android:textColor="?attr/accentTextColor"
                android:textSize="14sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/commentsLoadingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    app:indicatorColor="?attr/secondaryColor"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="4dp" />
            </FrameLayout>
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
