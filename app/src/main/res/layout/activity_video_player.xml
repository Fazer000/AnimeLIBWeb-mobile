<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_color"
    android:fitsSystemWindows="false">

    <!-- Loading Overlay -->
    <LinearLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black_color"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/loadingProgress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:indeterminateTint="@color/white_color" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Загрузка видео..."
            android:textColor="?attr/primaryTextColor"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Video Player View -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:animation_enabled="false"
        app:controller_layout_id="@layout/custom_player_controller"
        app:repeat_toggle_modes="none"
        app:show_buffering="never"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_shuffle_button="false"
        app:show_subtitle_button="false" />
    
    <!-- Anime Info Placeholder (показывается слева от панели озвучек когда не выбрана озвучка) -->
    <include
        android:id="@+id/animeInfoPlaceholder"
        layout="@layout/anime_info_placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginEnd="320dp"
        android:visibility="gone" />

    <!-- Next Episode Overlay (показывается перед автовоспроизведением следующего эпизода) -->
    <include
        android:id="@+id/nextEpisodeOverlay"
        layout="@layout/next_episode_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Swipe seek preview -->
    <TextView
        android:id="@+id/seekPreviewText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/video_time_background"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:text="+0 c"
        android:textColor="?attr/primaryTextColor"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Hold-to-speed plaque -->
    <TextView
        android:id="@+id/holdSpeedToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="80dp"
        android:background="@drawable/video_time_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="2x"
        android:textColor="?attr/primaryTextColor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Skip segment button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/skipSegmentButton"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:paddingVertical="0dp"
        android:paddingHorizontal="15dp"
        android:textAllCaps="false"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="80dp"
        android:layout_marginEnd="20dp"
        android:text="Пропустить сегмент"
        android:textColor="@color/gray_color"
        android:textSize="14dp"
        app:rippleColor="@color/dt_line_color"
        style="@style/Widget.Material3.Button.TextButton"
        android:backgroundTint="?attr/alphaPrimaryColor"
        app:strokeColor="?attr/alphaBorderColor"
        app:strokeWidth="0.5dp"
        app:cornerRadius="12dp"
        android:visibility="gone" />

    <View
        android:id="@+id/menuOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dt_alpha_primary_color"
        android:clickable="true"
        android:visibility="gone" />

    <!-- Sliding Menu Panel -->
    <com.example.animelib.ui.DraggableSidePanel
        android:id="@+id/menuPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        
        <include layout="@layout/panel_voiceover_menu" />
        
    </com.example.animelib.ui.DraggableSidePanel>

    <!-- Comments Side Panel -->
    <com.example.animelib.ui.DraggableSidePanel
        android:id="@+id/commentsPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        
        <include layout="@layout/panel_comments" />
        
    </com.example.animelib.ui.DraggableSidePanel>
</FrameLayout>
