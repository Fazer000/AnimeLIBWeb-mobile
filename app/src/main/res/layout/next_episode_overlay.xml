<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="?attr/primaryColor"
    android:gravity="center"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Следующий эпизод"
            android:textColor="?attr/accentTextColor"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Номер эпизода -->
        <TextView
            android:id="@+id/nextEpisodeNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="эпизод 9"
            android:textColor="?attr/primaryTextColor"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Таймер -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Начнётся через"
                android:textColor="?attr/accentTextColor"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/nextEpisodeCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="7"
                android:textColor="?attr/secondaryColor"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Кнопки -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <!-- Кнопка Отмена -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelNextEpisodeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Отмена"
                android:textColor="?attr/primaryTextColor"
                android:textSize="14sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                app:cornerRadius="12dp"
                app:strokeColor="?attr/borderColor"
                app:strokeWidth="1dp"
                app:backgroundTint="@android:color/transparent"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Кнопка Воспроизвести -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/playNextEpisodeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Воспроизвести"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                app:cornerRadius="12dp"
                app:backgroundTint="?attr/secondaryColor"
                style="@style/Widget.Material3.Button" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

