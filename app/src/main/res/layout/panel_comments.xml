<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commentsPanel"
    android:layout_width="320dp"
    android:layout_height="match_parent"
    android:layout_gravity="end"
    android:background="@android:color/transparent"
    android:elevation="16dp"
    android:orientation="horizontal">

    <!-- Drag Handle - слева вертикально -->
    <FrameLayout
        android:id="@+id/dragZone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingHorizontal="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/drag_handle" />
    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/primaryColor"
        android:elevation="20dp"
        app:cardCornerRadius="20dp">
        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/black_color"
                app:cardCornerRadius="16dp"
                app:cardElevation="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/black_color"
                    android:orientation="vertical">
                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/menu_header_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.02"
                            android:text="Комментарии"
                            android:textColor="?attr/primaryTextColor"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/commentsOptionsButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/button_ripple_effect"
                            android:contentDescription="Options"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_more_vert"
                            app:tint="?attr/primaryTextColor" />

                        <ImageButton
                            android:id="@+id/closeCommentsButton"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/button_close_background"
                            android:contentDescription="Close Comments"
                            android:padding="8dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_close"
                            app:tint="?attr/primaryTextColor" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <FrameLayout
                android:id="@+id/commentsContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/commentsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/emptyCommentsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Комментариев пока нет"
                    android:textColor="?attr/accentTextColor"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/commentsLoadingOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        app:indicatorColor="?attr/secondaryColor"
                        app:trackCornerRadius="8dp"
                        app:trackThickness="4dp" />
                </FrameLayout>
            </FrameLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
