<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Player Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/firstRow"
            android:paddingHorizontal="10dp"
            android:paddingVertical="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/primaryTextColor"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_semibold"
            android:text="Anilibria.tv"
            android:layout_marginEnd="12dp"
            android:letterSpacing="0.01"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/subTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/tag_sub_background"
            android:text="SUB"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="?attr/blueColor"
            android:visibility="gone"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/fhdTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/tag_fhd_background"
            android:text="FHD"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="?attr/secondaryTextColor"
            android:visibility="gone"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/fourKTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/tag_fhd_background"
            android:text="4K"
            android:textStyle="bold"
            android:textSize="10sp"
            android:textColor="?attr/secondaryTextColor"
            android:visibility="gone"
            android:layout_marginEnd="10dp"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="?attr/lineColor" />

</LinearLayout>