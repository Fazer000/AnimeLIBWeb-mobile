<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="?attr/primaryColor"
    app:cardElevation="20dp"
    android:layout_marginHorizontal="10dp"
    android:layout_marginBottom="20dp"
    android:elevation="100dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="@drawable/bottom_sheet_handle"
            android:layout_marginVertical="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="12dp"
            android:text="Продолжить смотреть"
            android:textColor="?attr/primaryTextColor"
            android:textSize="16dp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/bookmarkProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_background"/>

        <!-- Список закладок -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/bookmarks_viewpager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <!-- Индикаторы страниц -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/bookmarks_tab_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:tabIndicatorColor="?attr/secondaryColor"
            app:tabSelectedTextColor="?attr/primaryTextColor"
            app:tabTextColor="?attr/accentTextColor" />
    </LinearLayout>
</androidx.cardview.widget.CardView>


